<Project Sdk="Microsoft.NET.Sdk">
  <!-- IntelliSense context only: Scripts are still executed by Metatogger. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.csx" />
    <Compile Include="*.cs" />
    <Reference Include="Metatogger">
      <HintPath>Metatogger.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>